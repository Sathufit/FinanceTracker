<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/cardBackground"
    android:layout_marginBottom="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">
        <!-- Category Icon Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/categoryIconContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/secondaryLightColor"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/categoryIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_shopping"
                android:layout_gravity="center"
                app:tint="@color/white"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Grocery Shopping"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/categoryIconContainer"
            app:layout_constraintEnd_toStartOf="@id/textAmount"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Food &amp; Groceries"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toEndOf="@id/categoryIconContainer"
            app:layout_constraintEnd_toStartOf="@id/textDate"
            app:layout_constraintTop_toBottomOf="@id/textTitle" />

        <!-- Amount Text - Changed colorExpense to expenseColor -->
        <TextView
            android:id="@+id/textAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$56.78"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/expenseColor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Date Text - Changed textTertiary to textSecondary -->
        <TextView
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today, 2:30 PM"
            android:textSize="12sp"
            android:textColor="@color/textSecondary"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textAmount" />

        <!-- Optional: Payment Method - Changed textTertiary to textSecondary -->
        <TextView
            android:id="@+id/textPaymentMethod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Visa •••• 4321"
            android:textSize="12sp"
            android:textColor="@color/textSecondary"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:visibility="visible"
            app:layout_constraintStart_toEndOf="@id/categoryIconContainer"
            app:layout_constraintEnd_toStartOf="@id/textDate"
            app:layout_constraintTop_toBottomOf="@id/textCategory" />

        <!-- Optional: Action Buttons -->
        <LinearLayout
            android:id="@+id/actionButtonsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/categoryIconContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textPaymentMethod">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEdit"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Edit"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:cornerRadius="18dp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelete"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Delete"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:layout_marginStart="8dp"
                app:cornerRadius="18dp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>